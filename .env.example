# --- Bot (required) ---
TELEGRAM_BOT_TOKEN=
# For Bale: https://tapi.bale.ai
BOT_API_BASE=https://api.telegram.org
# Formatting of forwarded emails: HTML, Markdown or none
BOT_PARSE_MODE=HTML
TELEGRAM_PROXY=

# Users add their own accounts from the bot (stored in SQLite at DB_FILE).
DB_FILE=/data/bot.db
# Optional: only these chat ids may use the bot (comma-separated). Empty = anyone.
ALLOWED_CHAT_IDS=

# --- Optional: import an existing single-user setup for this chat on first start ---
TELEGRAM_CHAT_ID=
EWS_USERNAME=
EWS_PASSWORD=
EWS_EMAIL=
SAMAD_USERNAME=
SAMAD_PASSWORD=

# --- Tuning ---
EWS_ENDPOINT=https://email.iust.ac.ir/EWS/Exchange.asmx
POLL_SECONDS=60
SAMAD_SELF_ID=1
SAMAD_REMIND_HOUR=10
# Reminder days (Mon=0 ... Wed=2 Thu=3 ... Sun=6)
SAMAD_REMIND_DAYS=2,3
